{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "tabWidth": 4,
    "sortImports": true,
    "sortPackageJson": true,
    "sortTailwindcss": {
        "stylesheet": "./app/styles.css"
    },
    "overrides": [
        {
            "files": ["**/*.yml", "**/*.yaml"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
